* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #0f0f1a;
    color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    overflow: hidden;
}

.screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 600px;
    padding: 2.5rem;
    background-color: #1a1a2e;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    text-align: center;
}

.hidden {
    display: none !important;
}

.title {
    font-size: 3rem;
    color: #ffd700;
    margin-bottom: 0.5rem;
    letter-spacing: 2px;
}

.subtitle {
    font-size: 1.1rem;
    color: #a0a0c0;
    margin-bottom: 2.5rem;
}

.btn {
    background-color: #4e54c8;
    color: white;
    border: none;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    margin: 0.5rem 0;
    width: 100%;
    max-width: 280px;
}

.btn:hover {
    background-color: #6c72e6;
    transform: translateY(-2px);
}

.btn.secondary {
    background-color: #33334d;
}

.btn.secondary:hover {
    background-color: #444466;
}

/* Quiz Screen Styles */
.header-info {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-size: 1.1rem;
    font-weight: bold;
    color: #ffd700;
    margin-bottom: 1.2rem;
    padding: 0 0.5rem;
}

#mascot-container {
    display: flex;
    align-items: center;
    background-color: #252542;
    padding: 0.8rem 1.2rem;
    border-radius: 12px;
    width: 100%;
    margin-bottom: 1.2rem;
    text-align: left;
    border-left: 4px solid #ffd700;
}

.mascot-avatar {
    font-size: 2rem;
    margin-right: 1rem;
}

.dialog-box {
    font-size: 0.95rem;
    color: #e0e0f0;
}

#question-container {
    background-color: #252542;
    padding: 1.5rem;
    border-radius: 12px;
    width: 100%;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
}

#question-text {
    font-size: 1.2rem;
    color: #ffffff;
    line-height: 1.4;
}

#answers-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
    margin-bottom: 1.2rem;
}

.btn-answer {
    background-color: #2b2b4a;
    color: white;
    border: 2px solid #3f3f74;
    padding: 1rem;
    font-size: 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
}

.btn-answer:hover:not(:disabled) {
    background-color: #3f3f74;
    border-color: #6c72e6;
}

.btn-answer.disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

#helps-container {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 0.5rem;
}

.btn-help {
    flex: 1;
    background-color: #5c3d88;
    color: white;
    border: none;
    padding: 0.7rem 0.5rem;
    font-size: 0.9rem;
    font-weight: bold;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-help:hover:not(:disabled) {
    background-color: #7b52b2;
}

.btn-help:disabled {
    background-color: #2a2a3d;
    color: #666;
    cursor: not-allowed;
}